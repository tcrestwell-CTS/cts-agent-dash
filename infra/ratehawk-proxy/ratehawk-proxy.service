[Unit]
Description=RateHawk static-IP proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ratehawk
WorkingDirectory=/opt/ratehawk-proxy
EnvironmentFile=/opt/ratehawk-proxy/.env
ExecStart=/usr/bin/node --experimental-strip-types /opt/ratehawk-proxy/src/server.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
